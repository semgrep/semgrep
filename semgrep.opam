# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Like grep but for code: fast and syntax-aware semantic code pattern for many languages"
description: """
Semgrep is like grep but for searching patterns at the AST level while
leveraging semantic information (e.g., types, control flow) for powerful
matching.

For more information see https://semgrep.dev
"""
maintainer: ["Yoann Padioleau <pad@semgrep.com>"]
authors: ["Yoann Padioleau <pad@semgrep.com>"]
license: "LGPL-2.1-only"
homepage: "https://semgrep.dev"
bug-reports: "https://github.com/semgrep/semgrep/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {= "5.4.0"}
  "ocaml-variants"
  "ocaml-option-flambda"
  "menhir" {= "20230608"}
  "tree-sitter"
  "semgrep-interfaces"
  "base" {>= "v0.17.3"}
  "fpath" {>= "0.7.3"}
  "bos" {>= "0.2.1"}
  "fileutils" {>= "0.6.6"}
  "uring" {os = "linux" & = "0.9"}
  "testo" {= "0.5.0"}
  "testo-lwt" {= "0.5.0"}
  "alcotest" {>= "1.9.1"}
  "alcotest-lwt" {>= "1.9.1"}
  "calendar" {>= "3.0.0"}
  "fmt" {>= "0.11.0"}
  "ocolor" {>= "1.3.1"}
  "ANSITerminal" {>= "0.8.5"}
  "terminal_size" {>= "0.2.0"}
  "uucp" {>= "17.0.0"}
  "uutf" {>= "1.0.4"}
  "logs" {>= "0.9.0"}
  "atdgen-runtime" {>= "3.0.0"}
  "atdgen" {>= "3.0.0"}
  "yojson" {>= "2.2.2"}
  "yaml" {>= "3.2.0"}
  "xmlm" {>= "1.4.0"}
  "sarif" {>= "0.3.1"}
  "cmdliner" {>= "2.0.0"}
  "ppxlib" {= "0.38.0"}
  "ppx_blob" {>= "0.9.0"}
  "ppx_deriving" {>= "6.0.3"}
  "ppx_deriving_yojson" {>= "3.9.1"}
  "ppx_hash" {>= "v0.17.0"}
  "ppx_inline_test" {>= "v0.17.0"}
  "ppx_sexp_conv" {>= "v0.17.1"}
  "visitors" {= "20260520"}
  "re" {>= "1.14.0"}
  "pcre2"
  "hex"
  "obackward"
  "ocamlgraph" {>= "2.2.0"}
  "parmap" {>= "1.2.5"}
  "semver" {>= "0.2.1"}
  "timedesc" {>= "3.1.0"}
  "lsp" {>= "1.22.0" & < "1.24.0"}
  "git" {>= "3.18.0"}
  "memtrace"
  "pyro-caml-instruments"
  "pyro-caml-ppx"
  "opentelemetry" {= "0.91.1"}
  "opentelemetry-client" {= "0.91.1"}
  "opentelemetry-client-ocurl" {= "0.91.1"}
  "opentelemetry-client-cohttp-eio" {= "0.91.1"}
  "opentelemetry-logs" {= "0.91.1"}
  "trace" {>= "0.12"}
  "ambient-context" {>= "0.2"}
  "ambient-context-lwt" {>= "0.2"}
  "ambient-context-eio" {>= "0.2"}
  "curl" {= "0.10.0"}
  "conf-libcurl" {= "2"}
  "uri" {>= "4.4.0"}
  "uuidm" {>= "0.9.10"}
  "cohttp" {>= "6.2.1"}
  "cohttp-lwt-unix" {>= "6.2.1"}
  "cohttp-eio" {>= "6.2.1"}
  "tls-lwt" {>= "2.0.3"}
  "emile" {>= "1.1"}
  "digestif" {>= "1.3.0"}
  "lwt" {>= "5.9.2"}
  "lwt_ppx" {>= "5.9.1"}
  "conf-libev" {os != "win32" & = "4-13"}
  "git-unix" {>= "3.18.0"}
  "eio" {= "1.2"}
  "eio_main" {= "1.2"}
  "tls-eio" {>= "2.0.3"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/semgrep/semgrep.git"
x-maintenance-intent: ["(latest)"]
(* pin-depends let's opam know where to pull the source for dependencies from *)
(* Since we're vendoring all these dependencies instead of pulling them from opam *)
(* we put them here! *)
pin-depends: [
  (* coupling: if this is removed, make sure the minimum ocaml version in *)
  (* dune-project is correct, and uncomment the line in semgrep.nix marked *)
  (* coupling: Ensure consistent commit SHA between the following files:
        - OSS/semgrep.opam.template
        - OSS/semgrep.opam
        - semgrep-pro.opam.template
        - semgrep-pro.opam
  *)
  ["ocaml-variants.5.4.0" "git+https://github.com/semgrep/ocaml.git#4046c817ed2ed5c2431300902d1bd306230bf3dd"]
  ["pcre2.dev" "git+https://github.com/semgrep/pcre2-ocaml.git#e88c082341e4ff278eed892c17032df83b26e585"]
  ["tree-sitter.dev" "git+https://github.com/semgrep/ocaml-tree-sitter-core.git#c4baff8d83b2e1f83f247acb11d0c9dafa5e48f7"]
  ["obackward.dev" "git+https://github.com/semgrep/obackward.git#e1c16766976b4fadd97097b96f96666e8e1cb98c"]
  (* coupling: update the submodule in cli/src/semgrep too *)
  ["semgrep-interfaces.dev" "git+https://github.com/semgrep/semgrep-interfaces.git#7e509db48c700cae49fe0372e2aa0410fa86d867"]
  (* TODO: Once we start releasing this as an opam package and it's stable
     we should just install these as normal opam packages instead of a submodule *)
  (* coupling: makefile pyro-caml-install commit sha for the pyro-caml binary *)
  ["pyro-caml-instruments.dev" "git+https://github.com/semgrep/pyro-caml.git#d6941d16419a7d73d60126a70400fdb4d207e2ab"]
  ["pyro-caml-ppx.dev" "git+https://github.com/semgrep/pyro-caml.git#d6941d16419a7d73d60126a70400fdb4d207e2ab"]
  ["memtrace.dev" "git+https://github.com/janestreet/memtrace.git#a88470c3de884182503ba5fcd4729e281e544731"]
]

(* Needed for alpine linux docker image. These used to get pulled in *)
(* automatically in alpine 3.21 but in >3.22 they dont *)
depexts: [
    ["pcre2-static"] {os-distribution = "alpine"}
    ["gmp-static"] {os-distribution = "alpine"}
    (* obackward statically links libdwarf/libunwind (and comprmarsh links *)
    (* libzstd); the fully-static alpine build needs the .a archives. The *)
    (* obackward opam package no longer declares these as depexts, so we *)
    (* require them here on the package that actually links them. *)
    ["zstd-static"] {os-distribution = "alpine"}
    ["xz-static"] {os-distribution = "alpine"}
    ["bzip2-static"] {os-distribution = "alpine"}
    ["libunwind-static"] {os-distribution = "alpine"}
]
