#! /usr/bin/env bash
#
# Import and patch up external files.
#
# Not the generic script because ocaml's grammar.js is in the subfolder
# 'grammars/ocaml'.
#
set -eu -o pipefail

mkdir -p src

rm -f src/scanner.c
cat ../tree-sitter-ocaml/grammars/ocaml/src/scanner.c \
  | sed -e 's:"../../../common/scanner.h":"scanner.h":' \
  > src/scanner.c

(
  cd src
  ln -sf ../../tree-sitter-ocaml/common/scanner.h .
)


mkdir -p test/corpus
(
  cd test/corpus
  if [ -L inherited ]; then rm -f inherited; fi
  mkdir -p inherited
  for file in ../../../tree-sitter-ocaml/test/corpus/*.txt; do
    ln -sf ../"$file" inherited/
  done
)
