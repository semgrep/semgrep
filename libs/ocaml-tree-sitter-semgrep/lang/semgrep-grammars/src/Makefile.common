#
# Build the upstream and semgrep-extended grammars under
# lang/semgrep-grammars/src/. Each grammar is generated using the tree-sitter
# version pinned for it in lang/upstream-grammars.json. There is no globally-selected tree-sitter
# binary here.
#

# src → semgrep-grammars → lang → ots.
# Language Makefiles are symlinks here; realpath so MAKEFILE_LIST is this file.
PROJECT_ROOT ?= $(abspath $(dir $(realpath $(lastword $(MAKEFILE_LIST))))/../../..)
export PROJECT_ROOT
LANG_SCRIPTS = $(PROJECT_ROOT)/scripts

# Sibling clones live under src/ as tree-sitter-*. Package-style requires
# (e.g. tree-sitter-c) resolve via NODE_PATH for Node. Requirements alone
# uses QuickJS (`--js-runtime native`), which ignores NODE_PATH and needs
# ./node_modules symlinks instead (see use_native below).
GRAMMAR_SRC := $(PROJECT_ROOT)/lang/semgrep-grammars/src
NODE_PATH := $(GRAMMAR_SRC):$(NODE_PATH)
export NODE_PATH
# Wrapper directory name (e.g. semgrep-requirements) for per-language generate policy.
WRAPPER_NAME := $(notdir $(CURDIR))

# 'tree-sitter test' compiles the *generated* parser.c as C++ whenever the
# grammar has a scanner.cc, and g++ rejects its C99 designated initializers
# ("non-trivial designated initializers not supported", "designator order ...
# does not match declaration order") with no flag to opt out; clang++ accepts
# them. `?=` cannot work here: make predefines CXX, hence the origin test.
ifeq ($(origin CXX),default)
  ifeq ($(shell command -v clang++ >/dev/null 2>&1 && echo yes),)
    $(error CXX defaults to clang++ (needed for scanner.cc grammars) but clang++ is not on PATH; install clang or set CXX)
  endif
  CXX := clang++
endif
export CXX

# Per-grammar build. The tree-sitter binary comes from the version directory
# that owns the grammar. ABI selection (tree-sitter validates metadata itself):
#   - ABI 15 when the grammar ships a tree-sitter.json and uses tree-sitter
#     >= 0.25.0.
#   - ABI 14 otherwise, for tree-sitter >= 0.24.0 (which introduced --abi).
#   - --no-bindings for older tree-sitter.
# JS runtime: default remains Node + NODE_PATH. Only requirements uses
# `--js-runtime native` (tree-sitter >= 0.26 QuickJS): several other grammars
# load ESM/`export` or otherwise fail under QuickJS (lua, proto, sfapex, …).
.PHONY: build
build: prep
	set -eu; \
	for dir in $$(find . -type d -name node_modules -prune -o -name grammar.js -print | xargs -I{} dirname {}); do \
	  ts_version=$$($(LANG_SCRIPTS)/ts-version-for-grammar-dir "$$dir"); \
	  ts_bindir=$(PROJECT_ROOT)/core/tree-sitter-$$ts_version/bin; \
	  if [ ! -x "$$ts_bindir/tree-sitter" ]; then \
	    echo "Error: tree-sitter $$ts_version is not installed at $$ts_bindir." >&2; \
	    echo "Install it with:" >&2; \
	    echo "  make -C $(PROJECT_ROOT)/../.. setup-tree-sitter-versions" >&2; \
	    exit 1; \
	  fi; \
	  echo "Generate parser in $$(pwd)/$$dir (tree-sitter $$ts_version)"; \
	  if ! [ -e "$$dir/src/parser.c" ] \
	     || [ "$$dir/grammar.js" -nt "$$dir/src/parser.c" ] \
	     || [ "$$dir/tree-sitter.json" -nt "$$dir/src/parser.c" ]; then \
	    if [ -f "$$dir/tree-sitter.json" ] \
	       && printf '%s\n%s\n' 0.25.0 "$$ts_version" | sort -V -C 2>/dev/null; then \
	      gen_args=--abi=15; \
	    elif printf '%s\n%s\n' 0.24.0 "$$ts_version" | sort -V -C 2>/dev/null; then \
	      gen_args=--abi=14; \
	    else \
	      gen_args=--no-bindings; \
	    fi; \
	    use_native=; \
	    if [ "$(WRAPPER_NAME)" = semgrep-requirements ] \
	       && printf '%s\n%s\n' 0.26.0 "$$ts_version" | sort -V -C 2>/dev/null; then \
	      use_native=1; \
	      gen_args="$$gen_args --js-runtime native"; \
	    fi; \
	    echo "  Running in $$dir: tree-sitter generate $$gen_args"; \
	    if [ -n "$$use_native" ]; then \
	      mkdir -p "$$dir/node_modules"; \
	      for d in $(GRAMMAR_SRC)/tree-sitter-*; do \
	        [ -d "$$d" ] || continue; \
	        ln -sfn "$$d" "$$dir/node_modules/$$(basename "$$d")"; \
	      done; \
	      (cd "$$dir" \
	       && PATH="$$ts_bindir:$$PATH" \
	          tree-sitter generate $$gen_args); \
	    else \
	      (cd "$$dir" \
	       && PATH="$$ts_bindir:$$PATH" \
	          NODE_PATH=$(GRAMMAR_SRC) \
	          tree-sitter generate $$gen_args); \
	    fi; \
	  else \
	    echo "$$dir/src/parser.c is up to date."; \
	  fi; \
	done

# Import, rename, patch etc. in a custom manner, as needed.
#
.PHONY: prep
prep:
	python3 $(LANG_SCRIPTS)/grammar_registry.py fetch $(patsubst semgrep-%,%,$(notdir $(CURDIR)))
	$(PROJECT_ROOT)/core/scripts/provision-tree-sitter $$($(LANG_SCRIPTS)/ts-version-for-lang $(patsubst semgrep-%,%,$(notdir $(CURDIR))))
	if [ -x prep ]; then ./prep; fi

.PHONY: test
test: build
	# 'tree-sitter test' can emit a large number of repetitive error
	# messages when compiling 'parser.c'.
	set -eu; \
	for dir in $$(find . -type d -name node_modules -prune -o -name grammar.js -print | xargs -L1 dirname); do \
	  ts_version=$$($(LANG_SCRIPTS)/ts-version-for-grammar-dir "$$dir"); \
	  ts_bindir=$(PROJECT_ROOT)/core/tree-sitter-$$ts_version/bin; \
	  if [ ! -x "$$ts_bindir/tree-sitter" ]; then \
	    echo "Error: tree-sitter $$ts_version is not installed at $$ts_bindir." >&2; \
	    echo "Install it with:" >&2; \
	    echo "  make -C $(PROJECT_ROOT)/../.. setup-tree-sitter-versions" >&2; \
	    exit 1; \
	  fi; \
	  echo "Test $$(pwd)/$$dir (tree-sitter $$ts_version)"; \
	  (cd "$$dir"; \
           show_log() { echo "..."; tail -n 1000 test.log; }; \
           if PATH="$$ts_bindir:$$PATH" tree-sitter test > test.log 2>&1; then \
             show_log; \
           else \
             show_log; \
             exit 1; \
           fi); \
	done

.PHONY: clean
clean:
	find . -type d -name node_modules -prune -exec rm -rf {} +
	find . -type f \( -name parser.c -o -name grammar.json -o -name node-types.json \) -exec rm -f {} +
