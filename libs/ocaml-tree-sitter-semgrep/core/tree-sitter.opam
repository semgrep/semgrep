depends: [
  "alcotest"
  "ANSITerminal"
  "atdgen"
  "cmdliner" {>= "2.0.0"}
  "conf-pkg-config"
  "dune" {>= "3.20"}
  "dune-configurator" {>= "3.10.0"}
  "base"
  "ocaml"
  "ppx_deriving"
  "ppx_deriving_yojson"
  "sexplib"
  "tsort" {>= "2.0"}
  "yojson"
  "odoc" {with-doc}
]
