; Build the upstream tree-sitter C runtime and CLI, and expose the
; ocaml-tree-sitter code generator for downstream grammar builds.

(rule
 (deps
  tree-sitter-version
  (:script scripts/download-tree-sitter))
 (target
  (dir tree-sitter-repo))
 (action
  ; Invoke via bash so Windows CreateProcess does not fail on '#!'.
  (run bash %{script} %{target})))

(rule
 (deps
  (:script scripts/build-tree-sitter-runtime)
  (:repo tree-sitter-repo))
 (target
  (dir tree-sitter-out))
 (action
  ; Keep shared libraries alongside the static archive: semgrep links
  ; tree-sitter dynamically and packaging bundles the shared library.
  (run bash %{script} %{make} %{repo} %{target})))

(rule
 (deps
  (:version tree-sitter-version)
  (:script scripts/install-tree-sitter-cli)
  scripts/provision-tree-sitter
  (:repo tree-sitter-repo))
 (target tree-sitter%{ext_exe})
 (action
  ; Reuse the prebuilt release binary (linux, macos, windows) rather than
  ; compiling tree-sitter-cli with Cargo, which requires Rust >= 1.84 on
  ; 0.26.11, and fall back to an out-of-tree Cargo build elsewhere (e.g. musl).
  (run bash %{script} %{version} %{repo} %{ext_exe} %{target})))

(alias
 (name default)
 (deps
  tree-sitter-out
  (alias_rec src/all)))

; Promote the generator binary to core/bin/ocaml-tree-sitter for
; non-dune per-language Makefiles (lang/Makefile.common).

(subdir
 bin
 (rule
  (mode
   (promote (until-clean)))
  (target ocaml-tree-sitter)
  (action
   (copy %{bin:ocaml-tree-sitter} %{target}))))

(install
 (section lib)
 (package tree-sitter)
 (dirs tree-sitter-out/include tree-sitter-out/lib))

(install
 (section bin)
 (package tree-sitter)
 (files tree-sitter%{ext_exe}))

(install
 (section bin)
 (package tree-sitter)
 (enabled_if
  (= %{os_type} Win32))
 (files
  (tree-sitter-out/bin/libtree-sitter.dll as libtree-sitter.dll)))
